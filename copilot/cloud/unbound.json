{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "bash": "bash .github/hooks/unbound.sh sessionStart", "timeoutSec": 60 }
    ],
    "userPromptSubmitted": [
      { "bash": "bash .github/hooks/unbound.sh userPromptSubmitted", "timeoutSec": 60 }
    ],
    "preToolUse": [
      { "bash": "bash .github/hooks/unbound.sh preToolUse", "timeoutSec": 60 }
    ],
    "postToolUse": [
      { "bash": "bash .github/hooks/unbound.sh postToolUse", "timeoutSec": 60 }
    ],
    "agentStop": [
      { "bash": "bash .github/hooks/unbound.sh agentStop", "timeoutSec": 60 }
    ],
    "sessionEnd": [
      { "bash": "bash .github/hooks/unbound.sh sessionEnd", "timeoutSec": 60 }
    ]
  }
}
